<svg width="800" height="360" viewBox="0 0 800 360" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <linearGradient id="popGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#073B74;stop-opacity:1" />
      <stop offset="60%" style="stop-color:#0B5ED7;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#042142;stop-opacity:1" />
    </linearGradient>
    <linearGradient id="goldGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#FFE680;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#C99A2E;stop-opacity:1" />
    </linearGradient>
    <filter id="shadow" x="-10%" y="-10%" width="120%" height="120%">
      <feDropShadow dx="0" dy="4" stdDeviation="6" flood-opacity="0.25"/>
    </filter>
  </defs>
  <rect width="800" height="360" rx="16" fill="url(#popGrad)" />
  
  <!-- Decorative Circles -->
  <circle cx="720" cy="80" r="180" fill="#2176D2" opacity="0.2" />
  <circle cx="100" cy="320" r="140" fill="#C99A2E" opacity="0.15" />
  <circle cx="750" cy="300" r="90" fill="#ffffff" opacity="0.05" />

  <!-- Badge / Icon Container -->
  <g filter="url(#shadow)">
    <circle cx="400" cy="90" r="46" fill="url(#goldGrad)" />
    <!-- Coin / Dividend Icon -->
    <path d="M400 62 C382 62 368 74 368 90 C368 106 382 118 400 118 C418 118 432 106 432 90 C432 74 418 62 400 62 Z M400 70 C412 70 422 79 422 90 C422 101 412 110 400 110 C388 110 378 101 378 90 C378 79 388 70 400 70 Z" fill="#073B74"/>
    <text x="400" y="99" font-family="'Inter', sans-serif" font-size="26" font-weight="900" fill="#073B74" text-anchor="middle">฿</text>
  </g>

  <!-- Typography -->
  <text x="400" y="175" font-family="'Noto Sans Thai', 'Sarabun', sans-serif" font-size="28" font-weight="bold" fill="#ffffff" text-anchor="middle" filter="url(#shadow)">
    ประกาศจ่ายเงินปันผลและเงินเฉลี่ยคืน
  </text>
  <text x="400" y="215" font-family="'Noto Sans Thai', 'Sarabun', sans-serif" font-size="22" font-weight="bold" fill="url(#goldGrad)" text-anchor="middle">
    ประจำปีบัญชี 2568
  </text>

  <!-- Subtitle Pill -->
  <rect x="230" y="245" width="340" height="42" rx="21" fill="rgba(255, 255, 255, 0.12)" stroke="rgba(255, 255, 255, 0.25)" stroke-width="1.5" />
  <text x="400" y="272" font-family="'Noto Sans Thai', 'Sarabun', sans-serif" font-size="16" fill="#EAF4FF" text-anchor="middle">
    โอนเงินเข้าบัญชีเรียบร้อยแล้ว ตรวจสอบยอดได้ทันที
  </text>

  <!-- Footnote -->
  <text x="400" y="325" font-family="'Noto Sans Thai', 'Sarabun', sans-serif" font-size="14" fill="#93C5FD" text-anchor="middle">
    สหกรณ์ออมทรัพย์สาธารณสุขระยอง จำกัด
  </text>
</svg>
